#!/usr/bin/env chimerax --script
open "./Data/Structures/Alphafold/Experimental_FlhB.pdb" name structure1
open "./Data/Structures/Alphafold/Alphafold_FliF.pdb" name structure2
hide all atoms
hide all bonds
cartoon style protein modeh default arrows f xsect oval width 1 thick 1
cartoon style nucleic xsect oval width 1 thick 1
hide all cartoon
show #1/A cartoon
show #2/A cartoon
color #1 blue
color #2 red
set bgColor white

